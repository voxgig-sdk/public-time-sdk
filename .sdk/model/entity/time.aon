# Entity: time

main: kit: entity: time: {

  alias: field: {}

  fields: [
    {
      format: "int64"
      name: "time"
      req: true
      short: "The current UNIX timestamp in milliseconds"
      type: "`$INTEGER`"
    }
  ]

  name: "time"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/time.json"
          segments: [
            {
              lit: "time.json"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/time.txt"
          segments: [
            {
              lit: "time.txt"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
